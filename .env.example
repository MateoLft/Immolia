# Copier ce fichier en .env.local et remplir les valeurs du projet Supabase « immolia »
# (bouton « Connect » > App Frameworks > Next.js). Ne jamais mettre la clé secrète ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Studio IA (clé secrète, côté serveur uniquement) : console Anthropic > API Keys
ANTHROPIC_API_KEY=
