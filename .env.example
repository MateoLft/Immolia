# Copier ce fichier en .env.local et remplir les valeurs du projet Supabase « immolia »
# (bouton « Connect » > App Frameworks > Next.js). Ne jamais mettre la clé secrète ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Studio IA (clé secrète, côté serveur uniquement) : console Anthropic > API Keys
ANTHROPIC_API_KEY=

# E-mails de visite (confirmation, rappel) : compte Resend (resend.com), côté serveur uniquement.
# MAIL_FROM doit appartenir à un domaine vérifié chez Resend.
RESEND_API_KEY=
MAIL_FROM=
